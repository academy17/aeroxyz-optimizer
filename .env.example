# RPC for every chain. {chain} is swapped for the Ankr slug (base, eth, optimism, arbitrum, robinhood_mainnet).
# A URL without {chain} serves Base only.
RPC_URL=https://rpc.ankr.com/{chain}/YOUR_ANKR_KEY
# Per-chain override by chain id. Needed for Ink (57073) and Arc (5042), which Ankr doesn't serve.
# RPC_URL_57073=
# RPC_URL_5042=
# Wallet owning the sAERO stake
OWNER_ADDRESS=0x07d79841B8bF0e151f95c984D3bB14F9233122EF
# sAERO stake id (optional; defaults to first stake owned by OWNER_ADDRESS)
AEROXYZ_TOKEN_ID=
